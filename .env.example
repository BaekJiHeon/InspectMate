# Server only. Never put API keys in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
ALLOW_EXTERNAL_API=false
MVTEC_ROOT=
INSPECTMATE_DATA_DIR=./data
DEFAULT_CATEGORY=metal_nut
API_TIMEOUT_SECONDS=60
MAX_RETRIES=2
MAX_EXTERNAL_REQUESTS=50
MAX_TOTAL_TOKENS=100000
MAX_OUTPUT_TOKENS=1200
# Optional explicit price configuration; leave blank for unestimated cost.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
MAX_BUDGET_USD=
